# Copy to .env for local live E2E runs. Never commit real API keys.

# Required for tests/e2e/test_live_bash_e2e.py and
# tests/e2e/test_live_openai_responses_e2e.py.
OPENAI_MODEL=
OPENAI_AUTH_TOKEN=

# Optional for OpenAI-compatible endpoints.
OPENAI_BASE_URL=

# Optional for eval adapters. Use openai-responses for the Responses API.
API_KIND=openai-chat

# Optional: reasoning depth. Set on the provider; the adapter maps this single
# knob to whatever each model/API expects (Chat reasoning_effort, Responses
# reasoning.effort, Anthropic adaptive/output_config or thinking.budget_tokens).
# Values: minimal | low | medium | high | xhigh. OPENAI_REASONING_EFFORT is a
# legacy alias still honored if REASONING_EFFORT is unset.
REASONING_EFFORT=

# Optional: write the live Responses e2e compact trace to this path.
E2E_TRACE_PATH=
